{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "a2a": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "caFile": {
                    "type": "string"
                },
                "caSecret": {
                    "type": "string"
                },
                "defaultAgent": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "fallbackIconUrlTemplate": {
                    "type": "string"
                },
                "namespace": {
                    "type": "string"
                },
                "saToken": {
                    "type": "object",
                    "description": "Ignored since the Slack-only release; accepted because the agent-platform umbrella still forwards it; removed in the next major release. It projected a ServiceAccount token for the Klaus-instance paths, which are gone; the pod mounts nothing for it any more.",
                    "additionalProperties": true
                },
                "tokenPath": {
                    "type": "string",
                    "description": "Ignored since the Slack-only release; accepted because the agent-platform umbrella still forwards it; removed in the next major release. It named a Bearer token file for the Klaus-instance paths, which are gone."
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "admin": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "port": {
                    "type": "integer"
                }
            }
        },
        "affinity": {
            "type": "object",
            "additionalProperties": true
        },
        "agentgateway": {
            "type": "object",
            "description": "Ignored since the Slack-only release; accepted because the agent-platform umbrella still forwards it; removed in the next major release.",
            "additionalProperties": true
        },
        "agentgatewayRoute": {
            "type": "object",
            "additionalProperties": true
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cli": {
            "type": "object",
            "description": "Ignored since the Slack-only release; accepted because the agent-platform umbrella still forwards it; removed in the next major release.",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "enabled": {
            "type": "boolean"
        },
        "fullnameOverride": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enforced": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "pullPolicy": {
                    "type": "string"
                },
                "registry": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "lifecycle": {
            "type": "object",
            "description": "Ignored since the Slack-only release; accepted because the agent-platform umbrella still forwards it; removed in the next major release.",
            "additionalProperties": true
        },
        "logLevel": {
            "type": "string"
        },
        "metrics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "name": {
            "type": "string"
        },
        "nodeSelector": {
            "type": "object",
            "additionalProperties": true
        },
        "obo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "callbackBaseUrl": {
                    "type": "string"
                },
                "connectors": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "existingSecret": {
                    "type": "string"
                },
                "musterUrl": {
                    "type": "string"
                },
                "persistence": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "accessMode": {
                            "type": "string"
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "existingClaim": {
                            "type": "string"
                        },
                        "size": {
                            "type": "string"
                        },
                        "storageClass": {
                            "type": "string"
                        }
                    }
                },
                "stateKey": {
                    "type": "string"
                },
                "store": {
                    "type": "string",
                    "enum": [
                        "bolt",
                        "secret"
                    ]
                },
                "storeKey": {
                    "type": "string"
                },
                "storePath": {
                    "type": "string"
                },
                "storeSecretName": {
                    "type": "string"
                }
            }
        },
        "observability": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "otlpEndpoint": {
                    "type": "string"
                },
                "otlpHeaders": {
                    "type": "object",
                    "description": "Headers sent with every trace export, e.g. the tenant of a multi-tenant",
                    "additionalProperties": true
                }
            }
        },
        "pod": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "group": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "id": {
                            "type": "integer"
                        }
                    }
                },
                "user": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "id": {
                            "type": "integer"
                        }
                    }
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Annotations on the pod template (merged over the chart's own). The agent platform sets `karpenter.sh/do-not-disrupt: \"true\"` here so Karpenter's consolidation works around the pod that holds the channel connections and the in-flight A2A streams instead of evicting it.",
            "additionalProperties": true
        },
        "podDisruptionBudget": {
            "type": "object",
            "description": "PodDisruptionBudget on the gateway pods. Off by default: with `replicaCount: 1` a `minAvailable: 1` budget refuses every voluntary eviction (node drains wait for the drain timeout), which is the intended guard for a single replica that carries live Slack turns, but a deliberate choice. Set exactly one of `minAvailable` / `maxUnavailable` (int or percentage); `unhealthyPodEvictionPolicy: AlwaysAllow` lets a pod that is not Ready be evicted regardless, so a crash-looping gateway never wedges a drain.",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "maxUnavailable": {
                    "type": [
                        "integer",
                        "string",
                        "null"
                    ]
                },
                "minAvailable": {
                    "type": [
                        "integer",
                        "string",
                        "null"
                    ]
                },
                "unhealthyPodEvictionPolicy": {
                    "type": "string",
                    "enum": [
                        "",
                        "IfHealthyBudget",
                        "AlwaysAllow"
                    ]
                }
            }
        },
        "podLabels": {
            "type": "object",
            "description": "Labels on the pod template.",
            "additionalProperties": false
        },
        "podSecurityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "replicaCount": {
            "type": "integer"
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "reviews": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowedCallers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "audience": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "routing": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "autoCreate": {
                    "type": "boolean",
                    "description": "Ignored since the Slack-only release; accepted because the agent-platform umbrella still forwards it; removed in the next major release. It created a Klaus instance on a route miss; there is no Klaus path left."
                },
                "boltPath": {
                    "type": "string"
                },
                "defaultTTL": {
                    "type": "string",
                    "description": "Ignored since the Slack-only release; accepted because the agent-platform umbrella still forwards it; removed in the next major release. It was the TTL of a Klaus route entry; a thread's lifetime is threadTTL."
                },
                "store": {
                    "type": "string",
                    "enum": [
                        "memory",
                        "valkey",
                        "bolt"
                    ]
                },
                "threadTTL": {
                    "type": "string"
                },
                "valkey": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "db": {
                            "type": "integer"
                        },
                        "existingSecret": {
                            "type": "string"
                        },
                        "keyPrefix": {
                            "type": "string"
                        },
                        "passwordKey": {
                            "type": "string"
                        },
                        "timeout": {
                            "type": "string"
                        },
                        "tls": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "serverName": {
                                    "type": "string"
                                }
                            }
                        },
                        "url": {
                            "type": "string"
                        },
                        "username": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "server": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "port": {
                    "type": "integer"
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "annotations": {
                    "type": "object",
                    "additionalProperties": false
                },
                "create": {
                    "type": "boolean"
                }
            }
        },
        "serviceMonitor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "interval": {
                    "type": "string"
                },
                "labels": {
                    "type": "object",
                    "description": "Labels on the ServiceMonitor, beside the chart's own. The Giant Swarm observability platform routes a scrape to a Mimir tenant by `observability.giantswarm.io/tenant`; a monitor without it writes to no tenant.",
                    "additionalProperties": true
                },
                "scrapeTimeout": {
                    "type": "string"
                }
            }
        },
        "serviceType": {
            "type": "string"
        },
        "slack": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "appToken": {
                    "type": "string"
                },
                "botToken": {
                    "type": "string"
                },
                "channelAllowlist": {
                    "type": "array"
                },
                "channelMode": {
                    "type": "string"
                },
                "dmMode": {
                    "type": "string"
                },
                "dropStale": {
                    "type": "boolean"
                },
                "enabled": {
                    "type": "boolean"
                },
                "mode": {
                    "type": "string"
                },
                "progress": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "clearReactionOnDone": {
                            "type": [
                                "boolean",
                                "null"
                            ]
                        },
                        "emojis": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "done": {
                                    "type": "string"
                                },
                                "failed": {
                                    "type": "string"
                                },
                                "working": {
                                    "type": "string"
                                }
                            }
                        },
                        "mode": {
                            "type": "string"
                        }
                    }
                },
                "secretName": {
                    "type": "string"
                },
                "signingSecret": {
                    "type": "string"
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "terminationGracePeriodSeconds": {
            "type": "integer",
            "description": "Seconds the kubelet gives the pod to stop before it is killed. The shutdown drains the HTTP servers (up to 15 s), then stops the channel adapters (up to 15 s more), which is when a Slack turn cut short posts its restart notice and clears its progress reaction; the rest is margin for the client and store closes. Lower than the drain plus the stop and a turn interrupted by a restart ends in silence."
        },
        "tolerations": {
            "type": "array"
        },
        "upstream": {
            "type": "object",
            "description": "Ignored since the Slack-only release; accepted because the agent-platform umbrella still forwards it; removed in the next major release.",
            "additionalProperties": true
        },
        "web": {
            "type": "object",
            "description": "Ignored since the Slack-only release; accepted because the agent-platform umbrella still forwards it; removed in the next major release.",
            "additionalProperties": true
        }
    }
}
